# ------------------------------------------------------------------------------
# Family Location — variáveis de ambiente (EXEMPLO)
#
# Copie este arquivo para `.env` e preencha os valores.
# Variáveis com o prefixo EXPO_PUBLIC_ são embutidas no bundle do app
# (não são segredos de servidor — nunca coloque chaves privadas aqui).
#
# NENHUMA destas variáveis é usada ainda nesta primeira entrega (fundação).
# Elas estão documentadas aqui para as próximas fases.
# ------------------------------------------------------------------------------

# Supabase (Fase 1 — backend/auth)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth (Fase 1 — login com Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Maps (Fase 3 — mapa no Android). Ative "Maps SDK for Android" no Google Cloud.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
